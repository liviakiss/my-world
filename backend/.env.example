ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require&channel_binding=require
JWT_SECRET=generate-with-python-secrets-token-urlsafe-64
IP_HASH_SECRET=generate-with-python-secrets-token-urlsafe-64
COOKIE_SECURE=false
