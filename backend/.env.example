ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require&channel_binding=require
JWT_SECRET=generate-with-python-secrets-token-urlsafe-64
IP_HASH_SECRET=generate-with-python-secrets-token-urlsafe-64
COOKIE_SECURE=false
# Optional: TMDB "API Read Access Token" enables movie, TV and anime search
# TMDB_API_TOKEN=

FRONTEND_URL=http://localhost:3000
# console = print emails in the terminal (development); resend = really send them
EMAIL_PROVIDER=console
# EMAIL_FROM=My World <hello@your-domain>
# RESEND_API_KEY=
